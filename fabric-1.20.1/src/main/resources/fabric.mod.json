  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/compass-to-map",
    "issues":   "https://www.curseforge.com/minecraft/mc-mods/compass-to-map/comments",
    "sources":  "https://github.com/KURONAMI333/compass-to-map"
